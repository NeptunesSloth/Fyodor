# Copy to `.env` and fill in. NEVER commit `.env` (it is gitignored).
# Secrets are read from the environment in preference to config.yaml.

# Database (optional). Defaults to SQLite at state/fyodor.db.
# FYODOR_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/fyodor

# Discord alerts
FYODOR_DISCORD_WEBHOOK=

# Telegram alerts
FYODOR_TELEGRAM_TOKEN=
FYODOR_TELEGRAM_CHAT_ID=

# Email (SMTP) alerts
FYODOR_SMTP_USER=
FYODOR_SMTP_PASSWORD=

# --- IMPORTANT: payment & account security -------------------------------
# Fyodor never stores your card details. Checkout uses a local, gitignored
# browser profile (browser-profile/) that YOU log into once. Keep that folder
# private and off version control. Do not run trusted auto-buy on shared machines.
