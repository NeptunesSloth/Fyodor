# Copy to backend/.env (or export in your shell). All settings are optional.
# FYODOR_DATA_DIR=../data
# FYODOR_HOST=127.0.0.1        # 0.0.0.0 to allow LAN players
# FYODOR_PORT=8000
# FYODOR_LOG_LEVEL=INFO
# FYODOR_AUTOSAVE_EVERY=10
# FYODOR_HISTORY_LIMIT=500
# FYODOR_AUTO_BACKUP_MINUTES=30   # automatic backups while anything changes (0 = off)
# FYODOR_BACKUP_COPY_DIR=E:/Fyodor backups   # also copy every backup here (USB stick, synced folder)
# FYODOR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # none by default; FYODOR_DEV_TOOLS=1 trusts these two
# FYODOR_ASSISTANT_URL=http://127.0.0.1:11434   # optional Ollama endpoint (rules assistant)
# FYODOR_ASSISTANT_MODEL=llama3.1
