# Local data (card DB, images, saves) — never committed
/data/*
!/data/.gitkeep
# …except researched rules and the (card-pool, not pod) coverage reports, which ship with the code
!/data/rules/
!/data/reports/
/data/reports/*
!/data/reports/commander_rules_coverage.*
!/data/reports/commander_coverage.md
!/data/reports/rules_changes.md
!/data/reports/sba_audit.md
!/data/reports/mechanics.md

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
frontend/dist/
*.tsbuildinfo

# Editors / OS
.DS_Store
.idea/
.vscode/
.env

# Browser tests
frontend/test-results/
frontend/playwright-report/
/dist/
/build/

# downloadable app builds (scripts/build-app.sh, zipped for sharing)
/Fyodor-*.zip
/Fyodor-Setup-*.exe
