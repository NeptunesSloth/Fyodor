+def jacob_two(s):
+    source = cast(s, JACOB)
+    to_phase(s, "main1", turn=4)
+    settle(s)
+    bear = put(s, "Grizzly Bears", "hand")
+    land = put(s, "Forest", "hand")
+    act(s, "p1", type="activate_ability", card_id=source.id, ability=ability(s, source, "{T}:"))
+    settle(s)
+    answer(s, [bear.id])
+    settle(s)
+    mana(s, C=4, U=2)
+    d = s.state.rules.decision
