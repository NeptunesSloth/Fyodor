    "rulings": {
      "object": "list",
      "has_more": false,
      "data": [
        {
          "object": "ruling",
          "oracle_id": "efaa1262-b7ac-49ab-831a-d10b59680691",
          "source": "wotc",
          "published_at": "2016-08-23",
          "comment": "Attacking a planeswalker isn\u2019t the same thing as attacking a player. Both Canal Courier and the other creature must attack different players for the last ability to trigger."
        },
        {
          "object": "ruling",
          "oracle_id": "efaa1262-b7ac-49ab-831a-d10b59680691",
          "source": "wotc",
          "published_at": "2016-08-23",
          "comment": "The game starts with no monarch. Once an effect makes one player the monarch, the game will have exactly one monarch from that point forward."
        },
        {
          "object": "ruling",
          "oracle_id": "efaa1262-b7ac-49ab-831a-d10b59680691",
          "source": "wotc",
          "published_at": "2016-08-23",
          "comment": "Being the monarch carries two inherent triggered abilities. \u201cAt the beginning of the monarch\u2019s end step, that player draws a card\u201d and \u201cWhenever a creature deals combat damage to the monarch, its controller becomes the monarch.\u201d"
        },
        {
          "object": "ruling",
          "oracle_id": "efaa1262-b7ac-49ab-831a-d10b59680691",
          "source": "wotc",
          "published_at": "2016-08-23",
          "comment": "Abilities that trigger whenever you \u201cbecome the monarch\u201d trigger only if you aren\u2019t already the monarch. For example, if you are already the monarch as Custodi Lich enters the battlefield, its last ability won\u2019t trigger."
        },
        {
          "object": "ruling",
          "oracle_id": "efaa1262-b7ac-49ab-831a-d10b59680691",
          "source": "wotc",
          "published_at": "2016-08-23",
          "comment": "If the triggered ability that causes the monarch to draw a card goes on the stack, and a different player becomes the monarch before that ability resolves, the first player will still draw the card."
        }
      ]
    }
  },
