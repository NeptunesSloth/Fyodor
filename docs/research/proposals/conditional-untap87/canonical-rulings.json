    "rulings": {
      "object": "list",
      "has_more": false,
      "data": [
        {
          "object": "ruling",
          "oracle_id": "cba4ab80-09e8-4868-a082-a9a3bade9571",
          "source": "wotc",
          "published_at": "2010-03-01",
          "comment": "Creatures put onto the battlefield tapped don\u2019t cause Quest for Renewal\u2019s first ability to trigger."
        },
        {
          "object": "ruling",
          "oracle_id": "cba4ab80-09e8-4868-a082-a9a3bade9571",
          "source": "wotc",
          "published_at": "2010-03-01",
          "comment": "As another player\u2019s untap step begins, if there are four or more quest counters on Quest for Renewal, all your creatures untap during that untap step. You have no choice about what untaps. Those creatures untap at the same time as the active player\u2019s permanents."
        },
        {
          "object": "ruling",
          "oracle_id": "cba4ab80-09e8-4868-a082-a9a3bade9571",
          "source": "wotc",
          "published_at": "2010-03-01",
          "comment": "During another player\u2019s untap step, effects that would otherwise cause your creatures to stay tapped don\u2019t apply because they apply only during *your* untap step. For example, if you control a Quest for Renewal with four or more quest counters on it and a Deep-Slumber Titan (a creature that says \u201cDeep-Slumber Titan doesn\u2019t untap during your untap step\u201d), you untap Deep-Slumber Titan during each other player\u2019s untap step."
        },
        {
          "object": "ruling",
          "oracle_id": "cba4ab80-09e8-4868-a082-a9a3bade9571",
          "source": "wotc",
          "published_at": "2010-03-01",
          "comment": "Controlling more than one Quest for Renewal with four or more quest counters on it is redundant. You can\u2019t untap your permanents more than once in a single untap step."
        }
      ]
    }
