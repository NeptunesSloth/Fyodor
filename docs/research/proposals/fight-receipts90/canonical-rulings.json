    "rulings": [
      {
        "object": "ruling",
        "oracle_id": "aba04455-c13f-48f7-9674-56803b39a42b",
        "source": "wotc",
        "published_at": "2020-06-23",
        "comment": "A creature \u201cfights\u201d when an effect instructs it to fight. Dealing combat damage isn\u2019t fighting."
      },
      {
        "object": "ruling",
        "oracle_id": "aba04455-c13f-48f7-9674-56803b39a42b",
        "source": "wotc",
        "published_at": "2020-06-23",
        "comment": "You draw just one card as Neyith\u2019s first ability resolves, no matter how many creatures you control fought or became blocked."
      },
      {
        "object": "ruling",
        "oracle_id": "aba04455-c13f-48f7-9674-56803b39a42b",
        "source": "wotc",
        "published_at": "2020-06-23",
        "comment": "While resolving Neyith\u2019s last ability, you can\u2019t pay multiple times to double a creature\u2019s power more than once or to double more than one creature\u2019s power."
      },
      {
        "object": "ruling",
        "oracle_id": "aba04455-c13f-48f7-9674-56803b39a42b",
        "source": "wotc",
        "published_at": "2020-06-23",
        "comment": "If an effect instructs you to \u201cdouble\u201d a creature\u2019s power, that creature gets +X/+0, where X is its power as that effect begins to apply. If its power is negative, instead it gets -X/-0 where X is how far below 0 its power is. The value of X won\u2019t change if another effect alters the creature\u2019s power later in the turn."
      },
      {
        "object": "ruling",
        "oracle_id": "aba04455-c13f-48f7-9674-56803b39a42b",
        "source": "wotc",
        "published_at": "2020-06-23",
        "comment": "Only one creature is required to block the target creature. Other creatures may also block it and are free to block other creatures or not block at all."
      },
      {
        "object": "ruling",
        "oracle_id": "aba04455-c13f-48f7-9674-56803b39a42b",
        "source": "wotc",
        "published_at": "2020-06-23",
        "comment": "If the target creature has menace, two creatures must block it if able."
      },
      {
        "object": "ruling",
        "oracle_id": "aba04455-c13f-48f7-9674-56803b39a42b",
        "source": "wotc",
        "published_at": "2020-06-23",
        "comment": "The defending player, not you, chooses which creature blocks the target creature."
      },
      {
        "object": "ruling",
        "oracle_id": "aba04455-c13f-48f7-9674-56803b39a42b",
        "source": "wotc",
        "published_at": "2020-06-23",
        "comment": "If each creature the defending player controls can\u2019t block for any reason (such as being tapped), then the target creature isn\u2019t blocked. If there\u2019s a cost associated with blocking the target creature, the defending player isn\u2019t forced to pay that cost, so it doesn\u2019t have to be blocked in that case either."
      }
    ],
    "url": "https://api.scryfall.com/cards/0c1eed0f-9692-44c0-b1ad-afa691165d52/rulings"
