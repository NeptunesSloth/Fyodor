+"""Tezzeret's first artifact activation, with native actor and pre-cost source receipts."""
+from __future__ import annotations
+
+from typing import Any
+
+KEY = 'activated:{player}:artifact84'
+TEXT = 'The first activated ability of an artifact you activate each turn costs {2} less to activate.'
+
+
+def definition(ability: Any, ch: Any) -> dict[str, Any] | None:
+    if ability.text != TEXT:
+        return None
+    return {'kind': 'static', 'static': 'ability_cost_modifier', 'who': 'you', 'filter': None,
+            'delta': -2, 'floor': False, 'first_artifact84': True, 'effects': []}
+
+
+def used(state: Any, player: str) -> bool:
+    return state.rules.once_per_turn.get(KEY.format(player=player)) == state.turn.number
+
+
+def pending(state: Any, player: str) -> bool:
+    for decision in (state.rules.decision, state.rules.payment_outer):
+        then = (decision.resume or {}).get('paid_then') if decision is not None else None
+        if not then or then.get('actor') != player:
+            continue
+        payload = then.get('payload') or {}
+        if then.get('stage') in ('activation_announced', 'chosen_mana_paid') and 'Artifact' in (payload.get('ch') or {}).get('types', []):
+            return True
+        if then.get('stage') == 'production_paid' and payload.get('artifact_source84'):
+            return True
+    return False
+
+
+def available(state: Any, player: str, ch: Any) -> bool:
+    return ('Artifact' in ch.types and state.rules.artifact_activation_history_turn84 == state.turn.number
+            and not used(state, player) and not pending(state, player))
+
+
+def present(state: Any, player: str, info: Any) -> bool:
+    from app.rules import permissions
+
+    return any(src.controller == player and d.get('first_artifact84') for src, _, d in
+               permissions._table_statics(state, info, {'ability_cost_modifier'}))
+
+
+def require_known(plan: Any, ch: Any, cost: Any, player: str | None = None) -> None:
+    player = player or plan.actor
+    if ('Artifact' not in ch.types or not cost.generic or used(plan.state, player) or pending(plan.state, player)
+            or plan.rules.artifact_activation_history_turn84 == plan.state.turn.number):
+        return
+    if present(plan.state, player, plan.info):
+        from app.game.errors import ActionError
+
+        raise ActionError('This saved turn lacks artifact activation history; resolve the Tezzeret discount manually or begin a new native turn.')
+
+
+def record(plan: Any, player: str, artifact: bool | None) -> None:
+    if artifact is True:
+        plan.rules.once_per_turn[KEY.format(player=player)] = plan.state.turn.number
+    elif artifact is None:
+        plan.rules.artifact_activation_history_turn84 = None  # Old prepared source typing cannot establish a new negative.
