    "rulings": [
      {
        "object": "ruling",
        "oracle_id": "43b5e462-d860-473d-828f-6c513fc7768a",
        "source": "wotc",
        "published_at": "2017-09-29",
        "comment": "Admiral Beckett Brass's triggered ability checks what happened earlier in the turn. It doesn't care whether Admiral Beckett Brass was on the battlefield when those Pirates dealt combat damage, whether those creatures are still on the battlefield, or whether they're still Pirates."
      },
      {
        "object": "ruling",
        "oracle_id": "43b5e462-d860-473d-828f-6c513fc7768a",
        "source": "wotc",
        "published_at": "2017-09-29",
        "comment": "If one Pirate deals combat damage multiple times, most likely because it has double strike, it counts as only one of the three Pirates for Admiral Beckett Brass's triggered ability."
      },
      {
        "object": "ruling",
        "oracle_id": "43b5e462-d860-473d-828f-6c513fc7768a",
        "source": "wotc",
        "published_at": "2017-09-29",
        "comment": "If more than one player was dealt combat damage by three Pirates, you target only one permanent. It may be controlled by either of those players."
      },
      {
        "object": "ruling",
        "oracle_id": "43b5e462-d860-473d-828f-6c513fc7768a",
        "source": "wotc",
        "published_at": "2017-09-29",
        "comment": "The control-change effect of Admiral Beckett Brass's triggered ability lasts indefinitely. It doesn't wear off during the cleanup step or when you lose control of Admiral Beckett Brass."
      },
      {
        "object": "ruling",
        "oracle_id": "43b5e462-d860-473d-828f-6c513fc7768a",
        "source": "wotc",
        "published_at": "2017-09-29",
        "comment": "In a multiplayer game, if a player leaves the game, all cards that player owns leave as well, and any effects that give the player control of permanents immediately end."
      },
      {
        "object": "ruling",
        "oracle_id": "43b5e462-d860-473d-828f-6c513fc7768a",
        "source": "wotc",
        "published_at": "2017-09-29",
        "comment": "In a Two-Headed Giant game, combat damage dealt by Pirates your teammate controls will count when checking for Admiral Beckett Brass's ability."
      }
    ]
  },
