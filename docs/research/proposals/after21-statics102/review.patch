+if sys.argv[5]!='none':
+ cid=sys.argv[3] if sys.argv[5]=='card' else sys.argv[4]
+ act(s,'p1',type='move',card_ids=[cid],to={'player':'p1','zone':'hand'})
+ act(s,'p1',type='move',card_ids=[cid],to={'player':'p1','zone':'exile' if sys.argv[5]=='card' else 'battlefield'})
