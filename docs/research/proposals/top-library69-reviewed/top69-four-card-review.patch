+    land = put(s, "Forest", "battlefield")
+    enemy = put(s, "Grizzly Bears", "battlefield", pid="p2")
+    top = stack_library(s, ["Lightning Bolt", "Forest"])
+    for invalid in [land.id, enemy.id]:
+        before = s.state.model_dump(mode="json")
